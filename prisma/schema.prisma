// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Card {
  id        Int      @id @default(autoincrement())
  tribe     String
  color     String
  isDragon  Boolean  @default(false)
  location  String   @default("DECK")
  order     Int?

  // RELAÇÃO COM GAMESTATE: Para sabermos de qual jogo é esta carta
  gameStateId Int?
  gameState   GameState? @relation(fields: [gameStateId], references: [id])

  ownerId   Int?
  owner     Player?  @relation(fields: [ownerId], references: [id])
  
  bandId    Int?
  band      Band?    @relation(fields: [bandId], references: [id], name: "BandMembers")

  isLeaderOf Band?   @relation(name: "BandLeader")
}

model Player {
  id        Int      @id @default(autoincrement())
  name      String
  points    Int      @default(0)
  isBot     Boolean  @default(false)

  // RELAÇÃO COM GAMESTATE
  gameStateId Int?
  gameState   GameState? @relation(fields: [gameStateId], references: [id])

  cards     Card[]
  bands     Band[]
  markers   ControlMarker[]
}

model Kingdom {
  id         Int      @id @default(autoincrement())
  name       String   @unique
  gloryAge1  Int
  gloryAge2  Int
  gloryAge3  Int

  // RELAÇÃO COM GAMESTATE
  gameStateId Int?
  gameState   GameState? @relation(fields: [gameStateId], references: [id])

  markers    ControlMarker[]
}

model ControlMarker {
  id         Int      @id @default(autoincrement())
  count      Int      @default(0)
  playerId   Int
  player     Player   @relation(fields: [playerId], references: [id])
  kingdomId  Int
  kingdom    Kingdom  @relation(fields: [kingdomId], references: [id])

  @@unique([playerId, kingdomId])
}

model Band {
  id        Int      @id @default(autoincrement())
  size      Int
  leaderId  Int?     @unique
  leader    Card?    @relation(fields: [leaderId], references: [id], name: "BandLeader")
  playerId  Int
  player    Player   @relation(fields: [playerId], references: [id])
  cards     Card[]   @relation(name: "BandMembers")
}

model GameState {
  id              Int       @id @default(1)
  currentAge      Int       @default(1)
  dragonsFound    Int       @default(0)
  currentPlayerId Int       @default(1)
  gameStarted     Boolean   @default(false)
  activeTribes    String?

  // CAMPOS DE RELAÇÃO INVERSA: Essencial para o .findUnique({ include: { ... } })
  players         Player[]
  kingdoms        Kingdom[]
  cards           Card[]
}